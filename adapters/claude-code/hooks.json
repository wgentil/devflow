{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.py"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.py"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.py"
            ]
          }
        ]
      }
    ]
  }
}
